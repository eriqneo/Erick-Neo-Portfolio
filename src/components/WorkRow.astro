---
/**
 * Work index row: oversized title with tags, an accent arrow that slides in front of the
 * title on hover/focus, and a numbered strip of media below. Whole row is one link.
 */
import ProjectMedia from './ProjectMedia.astro';
import { mediaSlots, projectUrl, type Project } from '../data/projects';

interface Props {
  project: Project;
}
const { project: p } = Astro.props;
const slots = mediaSlots(p, 1);
---

<article class="row" data-reveal>
  <a href={projectUrl(p)} class="row__link">
    <span class="row__head">
      <span class="row__arrow row__arrow--in" aria-hidden="true">→</span>
      <h3 class="row__title" style={`view-transition-name:title-${p.slug}`}>{p.title}</h3>
      <span class="row__tags">
        <span>{p.kind}</span>
        {p.stack.slice(0, 2).map((t) => <span>{t}</span>)}
      </span>
      <span class="row__arrow row__arrow--out" aria-hidden="true">→</span>
    </span>
    <span class="row__strip" aria-hidden="true">
      {
        slots.map((src, i) => (
          <span class="row__slot">
            <span class="row__num">{String(i + 1).padStart(2, '0')}</span>
            <ProjectMedia
              src={src}
              video={i === 0 ? p.video : undefined}
              sizes="(max-width: 720px) 80vw, 33vw"
              vt={i === 0 ? `media-${p.slug}` : undefined}
            />
          </span>
        ))
      }
    </span>
  </a>
</article>

<style>
  .row {
    border-top: 1px solid var(--line);
  }

  .row__link {
    display: flex;
    flex-direction: column;
    gap: clamp(20px, 2.5vw, 32px);
    padding: clamp(28px, 4vw, 48px) 0;
    color: var(--fg);
  }

  .row__link:hover {
    color: var(--fg);
  }

  .row__head {
    display: flex;
    align-items: center;
    gap: clamp(12px, 2vw, 24px);
    min-width: 0;
  }

  .row__title {
    margin: 0;
    font-weight: 600;
    font-size: clamp(40px, 7vw, 112px);
    line-height: 0.95;
    letter-spacing: -0.045em;
    text-wrap: balance;
    transition: transform 0.7s var(--ease-out);
  }

  .row__tags {
    display: flex;
    flex-direction: column;
    gap: 2px;
    font-family: var(--ff-mono);
    font-size: 12px;
    color: var(--mut);
    white-space: nowrap;
    transition:
      opacity 0.4s ease,
      transform 0.7s var(--ease-out);
  }

  .row__arrow {
    color: var(--acc);
    font-size: clamp(36px, 5vw, 80px);
    line-height: 1;
    transition:
      transform 0.7s var(--ease-out),
      opacity 0.4s ease,
      width 0.7s var(--ease-out);
  }

  .row__arrow--out {
    margin-left: auto;
  }

  /* Incoming arrow starts collapsed to the left of the title. */
  .row__arrow--in {
    width: 0;
    opacity: 0;
    overflow: hidden;
    transform: translateX(-40%);
    margin-right: calc(-1 * clamp(12px, 2vw, 24px));
  }

  .row__link:is(:hover, :focus-visible) .row__arrow--in {
    width: 1em;
    opacity: 1;
    transform: none;
    margin-right: 0;
  }

  .row__link:is(:hover, :focus-visible) .row__arrow--out {
    opacity: 0;
    transform: translateX(40%);
  }

  .row__link:is(:hover, :focus-visible) .row__tags {
    opacity: 0;
    transform: translateX(16px);
  }

  .row__strip {
    display: grid;
    grid-auto-flow: column;
    /* Fixed thirds: one or two shots read as a deliberate strip, not a stretched banner. */
    grid-auto-columns: calc((100% - 2 * clamp(12px, 1.5vw, 20px)) / 3);
    gap: clamp(12px, 1.5vw, 20px);
    overflow-x: auto;
    scrollbar-width: none;
  }

  .row__strip::-webkit-scrollbar {
    display: none;
  }

  .row__slot {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 8px;
  }

  .row__slot :global(.media) {
    width: 100%;
    transition: transform 0.9s var(--ease-out);
  }

  .row__link:hover .row__slot :global(.media) {
    transform: translateY(-6px);
  }

  .row__link:hover .row__slot:nth-child(2) :global(.media) {
    transition-delay: 40ms;
  }

  .row__link:hover .row__slot:nth-child(3) :global(.media) {
    transition-delay: 80ms;
  }

  .row__num {
    font-family: var(--ff-mono);
    font-size: 12px;
    color: var(--mut);
  }

  @media (max-width: 719.98px) {
    .row__strip {
      grid-auto-columns: 80%;
    }

    .row__tags,
    .row__arrow--out {
      display: none;
    }
  }
</style>
