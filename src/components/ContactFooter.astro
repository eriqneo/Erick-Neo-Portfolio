---
import RollText from './RollText.astro';
import Avatar from './Avatar.astro';
import FooterStack from './FooterStack.astro';
import { links, navLinks, site } from '../data/site';

// ⚠ New copy (approved to proceed; one-word edits): column headings + signature.
const COPY = { sitemap: 'Sitemap', channels: 'Channels', signature: 'Tailored by Erick' };

// On sub-pages, section links point back to the homepage (Work → the /work index), like the nav.
const isHome = Astro.url.pathname === '/';
const sitemap = navLinks.map((l) => ({
  label: l.label,
  href: isHome ? l.href : l.href === '#work' ? '/work/' : `/${l.href}`,
}));

const channels = [
  { href: links.linkedin, label: 'LinkedIn ↗' },
  { href: links.github, label: 'GitHub ↗' },
  { href: links.dataPortfolio, label: 'Data portfolio ↗' },
  { href: links.codeRafiki, label: 'Code Rafiki ↗' },
];
---

<footer id="contact" class="footer">
  <div class="footer__top">
  <div class="footer__main">
    <span class="eyebrow">05 — Contact</span>
    <h2 class="footer__h2" data-arrive="words">
      Let's tailor your <span class="serif-i footer__acc">advantage.</span>
    </h2>
    <p class="footer__p">
      Tell me about the decision you're trying to make or the workflow you want automated. I'll come back
      with how I'd approach it.
    </p>
    <div class="footer__row">
      <a href={`mailto:${site.email}`} class="footer__email btn--ink">
        {site.email} <span aria-hidden="true">→</span>
      </a>
      <span class="footer__where">
        Kenya/Nairobi · <time data-clock></time> · working with clients worldwide
      </span>
    </div>
  </div>
  <Avatar size="clamp(132px, 17vw, 280px)" class="footer__avatar" />
  </div>
  <div class="footer__nav">
    <nav class="fcol" aria-labelledby="footer-sitemap">
      <h2 id="footer-sitemap" class="label fcol__h">{COPY.sitemap}</h2>
      <ul>
        {
          sitemap.map((l) => (
            <li>
              <a href={l.href} class="fcol__link">
                <RollText text={l.label} />
              </a>
            </li>
          ))
        }
        <li>
          <a href="#contact" class="fcol__link" data-drawer-open><RollText text="Let's talk" /></a>
        </li>
      </ul>
    </nav>

    <FooterStack />

    <nav class="fcol fcol--right" aria-labelledby="footer-channels">
      <h2 id="footer-channels" class="label fcol__h">{COPY.channels}</h2>
      <ul>
        {
          channels.map((l) => (
            <li>
              <a href={l.href} target="_blank" rel="noopener" class="fcol__link">
                <RollText text={l.label} />
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>

  <div class="footer__bar">
    <span>© 2026 {site.name}</span>
    <a href="#top" class="footer__link"><RollText text="Back to top ↑" /></a>
    <span class="footer__sig">
      <Avatar size="22px" decorative />
      {COPY.signature}
    </span>
  </div>
</footer>

<style>
  .footer {
    padding: clamp(80px, 12vw, 160px) var(--pad-x) 32px;
    display: flex;
    flex-direction: column;
    gap: clamp(56px, 8vw, 112px);
  }

  .footer__top {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 40px clamp(32px, 5vw, 80px);
  }

  .footer__main {
    flex: 1 1 560px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  @media (max-width: 719.98px) {
    :global(.footer__avatar) {
      order: -1;
    }
  }

  .footer__h2 {
    margin: 0;
    font-weight: 600;
    font-size: clamp(56px, 10.5vw, 180px);
    line-height: 0.88;
    letter-spacing: -0.045em;
    text-wrap: balance;
  }

  .footer__acc {
    color: var(--acc);
  }

  .footer__p {
    margin: 0;
    max-width: 560px;
    font-size: 19px;
    line-height: 1.5;
    color: var(--fg2);
    text-wrap: pretty;
  }

  .footer__row {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    align-items: center;
  }

  .footer__email {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 20px 30px;
    border-radius: var(--r-pill);
    font-weight: 600;
    font-size: clamp(18px, 1.8vw, 22px);
    transition:
      background-color 0.25s ease,
      color 0.25s ease;
  }

  .footer__where {
    font-size: 16px;
    color: var(--mut);
    padding: 0 12px;
  }

  .footer__bar {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    padding-top: 28px;
    border-top: 1px solid var(--line);
    font-family: var(--ff-mono);
    font-size: 13px;
    color: var(--mut);
  }

  /* ---------- Sitemap · stack · Channels ---------- */
  .footer__nav {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: start;
    gap: 48px clamp(24px, 4vw, 64px);
  }

  .fcol {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .fcol--right {
    align-items: flex-end;
    text-align: right;
  }

  .fcol__h {
    margin: 0;
    font-weight: 400;
  }

  .fcol ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .fcol--right ul {
    align-items: flex-end;
  }

  .fcol__link {
    font-weight: 600;
    font-size: clamp(20px, 1.9vw, 26px);
    letter-spacing: -0.02em;
    color: var(--mut);
    transition: color 0.25s ease;
  }

  .fcol__link:hover {
    color: var(--fg);
  }

  @media (max-width: 899.98px) {
    .footer__nav {
      grid-template-columns: 1fr 1fr;
    }

    .footer__nav :global(.fstack) {
      grid-column: 1 / -1;
      grid-row: 1;
    }
  }

  .footer__sig {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--fg2);
  }

  .footer__links {
    display: flex;
    flex-wrap: wrap;
    gap: 24px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer__link {
    color: var(--mut);
    transition: color 0.25s ease;
  }

  .footer__link:hover {
    color: var(--fg);
  }
</style>
