---
import type { GetStaticPaths } from 'astro';
import Layout from '../../layouts/Layout.astro';
import ProjectMedia from '../../components/ProjectMedia.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import RollText from '../../components/RollText.astro';
import {
  allProjects,
  mediaSlots,
  projectHost,
  projectUrl,
  type ProjectEntry,
} from '../../data/projects';
import { site } from '../../data/site';

export const getStaticPaths = (() =>
  allProjects.map((p) => ({ params: { slug: p.slug }, props: { project: p } }))) satisfies GetStaticPaths;

interface Props {
  project: ProjectEntry;
}
const { project: p } = Astro.props;
const { track } = p;
const [hero, ...gallery] = mediaSlots(p, 1);
const others = track.projects.filter((x) => x.slug !== p.slug);
const host = projectHost(p);
---

<Layout title={`${p.title} — ${site.name}`} description={p.body} image={p.image}>
  <header id="top" class="cs-hero">
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href="/work/" class="crumb"><RollText text="Work" /></a>
      <span class="crumb crumb--current" aria-current="page">{p.title}</span>
    </nav>

    <h1 class="cs-hero__h1" style={`view-transition-name:title-${p.slug}`}>{p.title}</h1>

    <div class="cs-hero__meta">
      <span class="cs-hero__kind">{p.n} · {p.kind}</span>
      <p class="cs-hero__body">{p.body}</p>
      <a href={p.href} target="_blank" rel="noopener" class="cs-hero__ext">
        <RollText text="Case study ↗" />
        <span class="cs-hero__host">{host}</span>
      </a>
    </div>

    <ProjectMedia
      src={hero}
      video={p.video}
      alt={p.imageAlt}
      sizes="100vw"
      chip={`${p.n} · ${p.kind}`}
      vt={`media-${p.slug}`}
      eager
      class="cs-hero__media"
    />
  </header>

  <section class="cs-body section" aria-labelledby="cs-details">
    <h2 id="cs-details" class="sr-only">{p.title}</h2>
    <div class="cs-cols">
      {
        p.story && (
          <div class="cs-story">
            {p.story.map((para) => (
              <p data-reveal>{para}</p>
            ))}
          </div>
        )
      }
      <dl class="cs-facts" data-reveal>
        <div class="cs-fact">
          <dt class="label">Work</dt>
          <dd>{track.label}</dd>
        </div>
        <div class="cs-fact">
          <dt class="label">Stack</dt>
          <dd>
            <ul>
              {p.stack.map((s) => <li>{s}</li>)}
            </ul>
          </dd>
        </div>
      </dl>
    </div>

    {
      gallery.length > 0 && (
        <div class="cs-gallery">
          {gallery.map((src, i) => (
            <figure class="cs-shot" data-reveal>
              <span class="cs-shot__n">{String(i + 2).padStart(2, '0')}</span>
              <ProjectMedia src={src} />
            </figure>
          ))}
        </div>
      )
    }
  </section>

  <section class="more section" aria-labelledby="more-title">
    <div class="section-head more__head">
      <span class="eyebrow">02 — Selected work</span>
      <h2 id="more-title" class="h2" data-arrive="words">{track.label}</h2>
    </div>
    <div class="more__grid">
      {others.map((o) => <ProjectCard project={o} />)}
    </div>
    <div class="more__all">
      <a href="/work/" class="btn btn--outline"><RollText text="Work" /> <span aria-hidden="true">→</span></a>
    </div>
  </section>
</Layout>

<style>
  .cs-hero {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: clamp(20px, 3vw, 40px) clamp(16px, 2vw, 32px);
    padding: clamp(48px, 8vw, 120px) var(--pad-x) var(--pad-y);
    border-bottom: 1px solid var(--line);
  }

  .crumbs {
    grid-column: 1 / -1;
    display: flex;
    gap: 6px;
    font-family: var(--ff-mono);
    font-size: 12.5px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .crumb {
    display: flex;
    padding: 6px 12px;
    border: 1px solid var(--line);
    border-radius: var(--r-pill);
    color: var(--mut);
    transition:
      color 0.25s ease,
      border-color 0.25s ease;
  }

  a.crumb:hover {
    color: var(--fg);
    border-color: var(--fg);
  }

  .crumb--current {
    background: var(--bg2);
    border-color: transparent;
    color: var(--fg);
  }

  .cs-hero__h1 {
    grid-column: 1 / -1;
    margin: 0;
    font-weight: 600;
    font-size: clamp(56px, 10.5vw, 184px);
    line-height: 0.9;
    letter-spacing: -0.045em;
    text-wrap: balance;
  }

  .cs-hero__meta {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr));
    gap: 16px 32px;
    align-items: start;
  }

  .cs-hero__kind {
    font-family: var(--ff-mono);
    font-size: 13px;
    color: var(--acc);
    padding-top: 4px;
  }

  .cs-hero__body {
    margin: 0;
    max-width: 460px;
    font-size: clamp(18px, 1.6vw, 22px);
    line-height: 1.45;
    color: var(--fg2);
    text-wrap: pretty;
  }

  .cs-hero__ext {
    display: flex;
    align-items: baseline;
    gap: 12px;
    justify-self: end;
    font-weight: 600;
    font-size: 18px;
  }

  .cs-hero__host {
    font-weight: 400;
    color: var(--mut);
  }

  .cs-hero :global(.cs-hero__media) {
    grid-column: 1 / -1;
    margin-top: clamp(16px, 3vw, 40px);
    border-radius: var(--r-portrait);
  }

  .cs-cols {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(40px, 6vw, 96px);
    margin-bottom: var(--pad-y);
  }

  .cs-story {
    flex: 2 1 440px;
    display: flex;
    flex-direction: column;
    gap: 1em;
  }

  .cs-story p {
    margin: 0;
    max-width: 640px;
    font-size: clamp(20px, 2vw, 28px);
    line-height: 1.35;
    letter-spacing: -0.015em;
    text-wrap: pretty;
  }

  .cs-facts {
    flex: 1 1 260px;
    margin: 0;
    display: flex;
    flex-direction: column;
  }

  .cs-fact {
    display: grid;
    grid-template-columns: minmax(80px, 120px) 1fr;
    gap: 16px;
    padding: 16px 0;
    border-top: 1px solid var(--line);
  }

  .cs-fact dt {
    padding-top: 4px;
  }

  .cs-fact dd {
    margin: 0;
    font-size: 17px;
  }

  .cs-fact ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .cs-gallery {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 440px), 1fr));
    gap: clamp(24px, 3vw, 40px);
  }

  .cs-shot {
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 8px;
  }

  .cs-shot :global(.media) {
    width: 100%;
  }

  .cs-shot__n {
    font-family: var(--ff-mono);
    font-size: 12px;
    color: var(--mut);
  }

  .more__head {
    margin-bottom: clamp(40px, 6vw, 72px);
  }

  .more__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 360px), 1fr));
    gap: clamp(40px, 5vw, 72px) clamp(24px, 3vw, 40px);
  }

  .more__all {
    display: flex;
    justify-content: center;
    margin-top: clamp(48px, 6vw, 80px);
  }
</style>
